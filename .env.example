# ========== 引擎选择 ==========
# cloud = 云端 API（效果优先）; local = 本地 Ollama（隐私优先）
LLM_PROVIDER=cloud
# 是否开启思考模式。RAG 问答场景建议关闭，否则单次响应可能慢 30 倍
ENABLE_THINKING=false

# ========== 云端 LLM ==========
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_API_KEY=sk-your-deepseek-key
CLOUD_LLM_MODEL=deepseek-flash

# ========== 云端 Embedding ==========
# 注意：DeepSeek 未提供 Embedding 接口，此处使用阿里云百炼
CLOUD_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_EMBEDDING_API_KEY=sk-your-dashscope-key
CLOUD_EMBEDDING_MODEL=text-embedding-v4
CLOUD_EMBEDDING_DIM=1024

# ========== 本地引擎（Ollama） ==========
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3.5:9b
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_NUM_CTX=8192

# ========== 检索参数 ==========
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVE_K=4
SCORE_THRESHOLD=0.3

# ========== 应用 ==========
API_PORT=8000
WEB_PORT=7860
LOG_LEVEL=INFO